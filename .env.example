# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Brand row id (seeded). Multi-brand ready.
BRAND_ID=5b1e0000-0000-4000-8000-000000000001

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://madcpnckxhyzzxucsgie.supabase.co
# Publishable (browser-safe) key — RLS protects data
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Secret / service role key — SERVER ONLY, never expose
SUPABASE_SERVICE_ROLE_KEY=
# Optional (migrations via CLI)
DATABASE_URL=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Fulfillment providers ----------
PRINTFUL_API_KEY=
# Required only for account-level tokens
PRINTFUL_STORE_ID=
# Random secret appended to the webhook URL (?token=...) — Printful v1 has no signatures
PRINTFUL_WEBHOOK_SECRET=
GELATO_API_KEY=
# Random secret appended to the webhook URL configured in the Gelato portal
GELATO_WEBHOOK_SECRET=

# ---------- Email ----------
RESEND_API_KEY=
EMAIL_FROM="HISPANIA <hola@example.com>"

# ---------- AI ----------
AI_PROVIDER_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---------- Security ----------
# Protects /api/cron/* (send as Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Comma-separated emails auto-granted SUPER_ADMIN on first admin login
ADMIN_EMAILS=
